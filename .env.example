# Shared client/server configuration. Copy this file to `.env` in the repository
# root. Values in `client/.env` or `server/.env` override matching root values.
# CRA only exposes `REACT_APP_*` variables to browser code; never use that prefix
# for secrets.

# OSRS cache base URL (trailing slash optional). Default: /caches/
# REACT_APP_CACHE_BASE_URL=https://game.example.com/caches/

# Default WebSocket endpoint before the player picks a server.
# REACT_APP_DEFAULT_WS_URL=wss://game.example.com

# Defaults shown on the login "server" button.
# REACT_APP_DEFAULT_SERVER_ADDRESS=game.example.com
# REACT_APP_DEFAULT_SERVER_NAME=My Server
# REACT_APP_DEFAULT_SERVER_SECURE=true

# Optional JSON array baked into the client (skips fetching /servers.json).
# REACT_APP_SERVERS_JSON=[{"name":"My Server","address":"game.example.com","secure":true,"maxPlayers":2047}]

# Optional remote server-list URL. Default: same-origin /servers.json
# REACT_APP_SERVER_LIST_URL=/servers.json

# Optional shared WebRTC relay configuration. The client receives only the
# public URL and ICE configuration; server registration values remain private.
# WEBRTC_SIGNAL_URL=wss://relay.example.com
# WEBRTC_ICE_SERVERS=[{"urls":"stun:relay.example.com:3478"}]
# WEBRTC_WORLD_ID=my-world
# WEBRTC_WORLD_NAME=My World
# WEBRTC_WORLD_TOKEN=replace-with-registration-token
# Dedicated worlds can advertise direct WebSocket gameplay while the relay
# continues to receive player counts over /signal.
# WORLD_WEBSOCKET_URL=wss://game.example.com

FAST_REFRESH=false
