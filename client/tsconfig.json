{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext", "ES2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@runelite/api/*": ["./runelite/api/*"],
      "@runelite/awt/*": ["./runelite/awt/*"],
      "@runelite/client/*": ["./runelite/client/*"],
      "@runelite/impl/*": ["./runelite/impl/*"]
    }
  },
  "include": [
    "common",
    "components",
    "config",
    "custom",
    "game",
    "media",
    "network",
    "picogl",
    "render",
    "rs",
    "runelite",
    "ui",
    "widgets",
    "*.ts",
    "*.tsx"
  ],
  "exclude": ["scripts", "build", "node_modules"]
}
