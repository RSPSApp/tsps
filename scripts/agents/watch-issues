#!/usr/bin/env python3
"""Print one line per issue opened since the last check, then keep polling.

    scripts/agents/watch-issues            # poll every 10 minutes, forever
    scripts/agents/watch-issues --once     # check once and exit

The first run only records the newest issue number. State lives in the shared git dir
(.git/agents/issues.last), so every worktree sees the same position. A line is a prompt
to triage, not a claim: re-check comments and PRs before claiming (docs/bug-loop.md).
"""
import json
import pathlib
import subprocess
import sys
import time

REPO = "RSPSApp/tsps"


def state_file():
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True, check=True).stdout.strip()
    path = pathlib.Path(common) / "agents" / "issues.last"
    path.parent.mkdir(exist_ok=True)
    return path


def open_issues():
    out = subprocess.run(["gh", "issue", "list", "--repo", REPO, "--state", "all", "--limit", "30",
                          "--json", "number,title,state,assignees,comments"],
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def check(path):
    issues = open_issues()
    if not path.exists():
        path.write_text(str(max(i["number"] for i in issues)))
        return
    last = int(path.read_text())
    for issue in sorted((i for i in issues if i["number"] > last), key=lambda i: i["number"]):
        if issue["state"] == "OPEN":
            print(f"NEW ISSUE #{issue['number']} assignees={len(issue['assignees'])} "
                  f"comments={len(issue['comments'])}: {issue['title']}", flush=True)
        last = issue["number"]
    path.write_text(str(last))


def main():
    path = state_file()
    while True:
        try:
            check(path)
        except Exception as error:  # keep polling through network blips
            print(f"watch-issues: {error}", flush=True)
        if "--once" in sys.argv:
            return
        time.sleep(600)


if __name__ == "__main__":
    main()
