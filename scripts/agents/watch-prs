#!/usr/bin/env python3
"""Print one line whenever a watched PR gets a comment, review, new commit or is merged/closed.

    scripts/agents/watch-prs 2338 2339     # these PRs, every 5 minutes, until all are done
    scripts/agents/watch-prs --once 2338   # check once and exit

A new head commit you didn't push usually means a reviewer pushed a repair: read the PR's
latest comment before touching the branch. Exits once every watched PR is merged or closed.
"""
import json
import subprocess
import sys
import time

REPO = "RSPSApp/tsps"


def snapshot(number):
    out = subprocess.run(["gh", "pr", "view", str(number), "--repo", REPO, "--json",
                          "state,comments,reviews,headRefOid,headRefName"],
                         capture_output=True, text=True, check=True).stdout
    pr = json.loads(out)
    return {"state": pr["state"], "comments": len(pr["comments"]), "reviews": len(pr["reviews"]),
            "head": pr["headRefOid"][:9], "branch": pr["headRefName"]}


def main():
    once = "--once" in sys.argv
    numbers = [int(arg) for arg in sys.argv[1:] if arg.isdigit()]
    if not numbers:
        sys.exit(__doc__)
    seen = {}
    while numbers:
        for number in list(numbers):
            try:
                now = snapshot(number)
            except Exception as error:
                print(f"watch-prs: #{number}: {error}", flush=True)
                continue
            before = seen.get(number)
            if before is None or now != before:
                changes = ", ".join(f"{key} {before[key]} -> {now[key]}" for key in now
                                    if before and now[key] != before[key])
                print(f"PR #{number} ({now['branch']}): {now['state']} "
                      f"comments={now['comments']} reviews={now['reviews']} head={now['head']}"
                      + (f" [{changes}]" if changes else ""), flush=True)
            seen[number] = now
            if now["state"] in ("MERGED", "CLOSED"):
                numbers.remove(number)
        if once:
            return
        if numbers:
            time.sleep(300)


if __name__ == "__main__":
    main()
