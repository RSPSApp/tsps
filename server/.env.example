# Elvarg web server environment sample
#
# Optional server overrides for the root `.env`. Server start/dev scripts load
# this file after the root file, while explicitly exported variables still win.

# Network binding
# Legacy raw-TCP client/flood-test destination. The TypeScript server currently
# accepts gameplay connections over WebSocket, not on this TCP port.
TCP_PORT=43594
# Port for the server's WebSocket listener and HTTP content endpoints.
WEBSOCKET_PORT=49598
# Optional public WebSocket URL advertised for this world in the relay directory.
# Requires WEBRTC_WORLD_ID and WEBRTC_WORLD_TOKEN. The relay can direct clients
# to this URL instead of negotiating a WebRTC gameplay connection.
# WORLD_WEBSOCKET_URL=wss://game.example.com
# HOST is used by the protocol test harness as the server address (default 127.0.0.1),
# not as the server listener's bind address.
# HOST=0.0.0.0

# Logging
# Comma-separated server log levels to emit: debug, info, warn, error.
LOG_LEVELS=info,warn,error
# Optional comma-separated type allowlist. When non-empty, only these tagged types
# (or `*`) are emitted; an empty value leaves the built-in defaults in effect.
LOG_ENABLED_TYPES=
# Comma-separated type denylist. Denied types are suppressed even if allowlisted.
LOG_DISABLED_TYPES=plugin,npc.face,Combat

# Runtime/debug controls
# Emit warnings when scheduled tasks exceed the slow-task threshold.
TASK_SLOW_WARN_ENABLED=1
# Username that receives developer rights on login. Leave unset unless needed.
# DEV_USERNAME=your-username
# Log extra projectile-processing diagnostics.
PROJECTILE_DEBUG=0
# Log extra magic-cast diagnostics.
MAGIC_CAST_DEBUG=0

# Bot controls
# Disable the player-bot plugin/runtime entirely.
DISABLE_PLAYER_BOTS=0
# Write bot runtime event details to the player-bots log.
BOT_RUNTIME_EVENT_LOGGING=0
# Write periodic bot runtime telemetry to its telemetry log.
BOT_RUNTIME_TELEMETRY_ENABLED=1
# Collect detailed bot task timings (diagnostic; can add overhead).
BOT_TASK_PROFILER_ENABLED=0
# Enforce the bot execution-time budget and its scheduler safeguards.
BOT_EXECUTION_BUDGET_ENABLED=1
# Minimum interval between repeated execution-budget warnings, in milliseconds.
BOT_EXECUTION_BUDGET_LOG_COOLDOWN_MS=5000
# Mirror routine bot runtime log entries into the central server logger.
BOT_MIRROR_CORE_LOGGING=0
# Also mirror bot errors into the central server logger.
BOT_MIRROR_ERRORS_TO_CORE_LOGGING=1
# Write bot logs to files. Overrides the server log-write setting for bot logs.
BOT_FILE_LOG_WRITES_ENABLED=1

# Outbound WebSocket backpressure guardrail
# Close a WebSocket client whose transport buffer reaches this many bytes.
OUTBOUND_WS_BUFFER_CRITICAL_BYTES=4194304

# In-game bug reports (Report a Bug, ::bug; docs/bug-reports.md)
# Reports become issues in this repository: a fine-grained token needs Issues and Contents
# read/write on it. Unset, reports are saved under data/saves/bug-reports/.
# BUG_REPORT_GITHUB_REPO=owner/bug-reports
# BUG_REPORT_GITHUB_TOKEN=github_pat_...
# Optional API root for GitHub Enterprise Server (default https://api.github.com).
# BUG_REPORT_GITHUB_API_URL=https://github.example.com/api/v3

# Protocol harness options for scripts/login-protocol-harness.ts
# Test account credentials used by the protocol harness only; these defaults are
# not production credentials. The harness also accepts HOST and PORT overrides.
PROTOCOL_USERNAME=smoketest
PROTOCOL_PASSWORD=smoketest
# Send the initial login/bootstrap sequence.
SEND_BOOTSTRAP=1
# Send the initial player movement after login.
SEND_MOVEMENT=1
# Repeat movement packets around the configured center and radius.
LOOP_MOVEMENT=0
# Send an object-click packet after login.
SEND_OBJECT_CLICK=0
# Decode and summarize packets received from the server.
DECODE_SERVER_FRAMES=1
# Optional sequence of in-game commands; separate commands with `||`.
# COMMAND_SEQUENCE=::players,::pos
# Optional second movement destination; set both coordinates to send it.
# SECOND_MOVE_X=3095
# SECOND_MOVE_Y=3520
# Plane for the optional second movement (defaults to the initial move's plane).
# SECOND_MOVE_PLANE=0
