# elvarg-web-server environment sample
#
# Optional server overrides for the root `.env`. Server start/dev scripts load
# this file after the root file, while explicitly exported variables still win.

# Network binding
# Raw TCP game server port used by Java clients. Set to 0 to disable.
TCP_PORT=43594
# WebSocket game server port used by the web client. Set to 0 to disable.
WEBSOCKET_PORT=49598
# Public gameplay endpoint for a dedicated world listed in the relay directory.
# Requires WEBRTC_WORLD_ID and WEBRTC_WORLD_TOKEN; disables WebRTC gameplay.
# WORLD_WEBSOCKET_URL=wss://game.example.com
# Address to bind listeners to. HOST takes precedence where both are read.
BIND_HOST=0.0.0.0
# HOST=0.0.0.0

# Optional voice signaling server. Set to 0 to disable.
# VOICE_SIGNAL_PORT=49599

# Logging
LOG_WRITES_ENABLED=1
LOG_LEVELS=info,warn,error
LOG_ENABLED_TYPES=
LOG_DISABLED_TYPES=plugin,npc.face,Combat
PACKET_LOGGING=0
PACKET_OUT_LOGGING=0
LOGIN_SESSION_VERBOSE_LOGGING=0

# Runtime/debug controls
TASK_SLOW_WARN_ENABLED=1
# DEV_USERNAME=your-username
PLAYER_UPDATE_BUCKET_COMPARE=0
PLAYER_UPDATE_DEBUG=0
PLAYER_UPDATE_DEBUG_RECEIVER=happysham31
PLAYER_UPDATE_DEBUG_TARGET=playerbot1
PROJECTILE_DEBUG=0
MAGIC_CAST_DEBUG=0

# Bot controls
DISABLE_PLAYER_BOTS=0
BOT_RUNTIME_EVENT_LOGGING=0
BOT_RUNTIME_TELEMETRY_ENABLED=1
BOT_TASK_PROFILER_ENABLED=0
BOT_EXECUTION_BUDGET_ENABLED=1
BOT_EXECUTION_BUDGET_LOG_COOLDOWN_MS=5000
BOT_MIRROR_CORE_LOGGING=0
BOT_MIRROR_ERRORS_TO_CORE_LOGGING=1
BOT_FILE_LOG_WRITES_ENABLED=1

# Outbound WebSocket/TCP backpressure guardrails
OUTBOUND_WS_BUFFER_HIGH_WATER_BYTES=1048576
OUTBOUND_WS_BUFFER_CRITICAL_BYTES=4194304
OUTBOUND_WS_QUEUE_HIGH_WATER_BYTES=524288
OUTBOUND_WS_QUEUE_MAX_FRAMES=512
OUTBOUND_WS_MAX_FRAMES_PER_FLUSH=256

# Protocol harness options for scripts/login-protocol-harness.ts
PROTOCOL_USERNAME=smoketest
PROTOCOL_PASSWORD=smoketest
SEND_BOOTSTRAP=1
SEND_MOVEMENT=1
LOOP_MOVEMENT=0
SEND_OBJECT_CLICK=0
DECODE_SERVER_FRAMES=1
# COMMAND_SEQUENCE=::players,::pos
# SECOND_MOVE_X=3095
# SECOND_MOVE_Y=3520
# SECOND_MOVE_PLANE=0
