{
  "env": { "TSPS_RESTARTER": "nodemon" },
  "ignoreRoot": [
    "**/.git/**",
    "**/.nyc_output/**",
    "**/.sass-cache/**",
    "**/bower_components/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/server/data/map-edits",
    "**/server/data/map-edits/**",
    "**/server/data/map-editor-backups/**",
    "**/server/data/saves/**",
    "**/server/data/regions/**",
    "**/server/data/models/**",
    "**/server/caches/**",
    "**/server/plugins/imported/**",
    "**/server/plugins/world/data/**",
    "**/server/plugins/bots/data/**",
    "**/server/plugins/agent/data/templates/**"
  ],
  "ignore": [
    "plugins/imported/**",
    ".plugin-upload-*/**",
    "data/saves/**",
    "caches/**",
    "plugins/world/data/**",
    "plugins/bots/data/**",
    "data/npc-spawns*.json",
    "data/definitions/npc-spawns*.json",
    "data/definitions/object-spawns*.json",
    "data/definitions/map-warps.json",
    "data/definitions/ground-items-custom.json",
    "data/map-editor-backups/**",
    "data/map-edits/**",
    "data/definitions/npc-combat-defs.json",
    "data/regions/**",
    "data/models/**",
    "plugins/agent/data/templates/**",
    "plugins/agent/data/edit-styles.json",
    "*.log"
  ]
}
