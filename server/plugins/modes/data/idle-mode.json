    "randomEvents": false,
    "levelUpPopups": false
  },
  "offline": {
    "_description": "A gathering session counts once it has run minSampleSeconds; a gap of more than maxGapSeconds between two gathers starts a new one. Time away is paid up to capHours at efficiency (1 = the rate the player had when they logged out).",
    "enabled": true,
    "minSampleSeconds": 60,
    "maxGapSeconds": 60,
    "capHours": 12,
    "efficiency": 1,
    "openScreenOnReturn": true,
    "openScreenDelayTicks": 3
  },
  "auto": {
    "_description": "Auto-resume (docs/idle-mode.md): an idle player's last gathering target is remembered, and when the gathering stops the character walks to the nearest one of the same name near where it started and uses the same option again.",
