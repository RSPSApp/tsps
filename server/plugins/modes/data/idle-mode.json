    "tickInterval": 2,
    "restartAfterSeconds": 12,
    "retrySeconds": 6,
    "rememberClickSeconds": 30,
    "searchTiles": 16,
    "leashTiles": 24,
    "maxFailedAttempts": 3,
    "skipSeconds": 120
  },
  "progression": {
    "_description": "Idle points (docs/idle-mode.md): one per xpPerPoint XP an idle account gains in the idle skills, online or offline. They buy the upgrades' levels, each level at its listed cost.",
